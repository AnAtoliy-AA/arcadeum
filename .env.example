# ============================================================================
# Shorts Factory — Environment Variables
# ============================================================================
# The shorts factory reads from the project root .env.
# App-specific vars are in their respective .env.example:
#   apps/be/.env.example     — backend (JWT, OAuth, SMTP, Solana, etc.)
#   apps/web/.env.example    — frontend (NEXT_PUBLIC_*, analytics, etc.)
#   apps/tg-bot/.env.example — Telegram bot
#
# Copy to root .env and fill in values. Never commit .env.

# ─── CDN ────────────────────────────────────────────────────────────────────
SHORTS_CDN_URL=

# ─── Postiz (Social Media Publishing) ──────────────────────────────────────
POSTIZ_BASE_URL=
POSTIZ_API_KEY=
POSTIZ_YOUTUBE_INTEGRATION_ID=
POSTIZ_INSTAGRAM_INTEGRATION_ID=
POSTIZ_X_INTEGRATION_ID=

# ─── Telegram Bot (Approval Flow) ──────────────────────────────────────────
TG_BOT_URL=
SHORTS_FACTORY_APPROVAL=

# ─── Bot User (Authenticated Gameplay Recording) ────────────────────────────
# Run: node scripts/shorts-factory/setup-bot-user.js
SHORTS_FACTORY_BOT_EMAIL=
SHORTS_FACTORY_BOT_USERNAME=
SHORTS_FACTORY_BOT_PASSWORD=
SHORTS_FACTORY_BOT_TOKEN=
SHORTS_FACTORY_BOT_REFRESH_TOKEN=

# ─── Backend URL (for setup-bot-user.js) ────────────────────────────────────
BE_URL=
