FROM node:24-alpine AS builder

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY scripts/ scripts/
COPY apps/be/package.json apps/be/
COPY packages/games-core/ packages/games-core/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store corepack enable && pnpm install --frozen-lockfile

COPY apps/be/ apps/be/

RUN pnpm --filter @arcadeum/games-core build && pnpm --filter be build
RUN corepack enable && pnpm --filter be deploy --prod --out /out

FROM node:24-alpine AS runner

WORKDIR /app

RUN apk add --no-cache dumb-init curl

# Stockfish 19 — detect arch at build time
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64)  SF_ASSET="stockfish-linux-x86-64-universal.tar.gz" ;; \
      aarch64) SF_ASSET="stockfish-linux-arm64-universal.tar.gz" ;; \
      *)       echo " unsupported arch $ARCH" && exit 1 ;; \
    esac && \
    curl -L -o /tmp/sf19.tar.gz \
      "https://github.com/official-stockfish/Stockfish/releases/download/sf_19/$SF_ASSET" && \
    mkdir -p /tmp/sf19-extract && \
    tar -xzf /tmp/sf19.tar.gz -C /tmp/sf19-extract && \
    find /tmp/sf19-extract -name "stockfish" -type f -executable -exec cp {} /usr/local/bin/stockfish \; && \
    chmod +x /usr/local/bin/stockfish && \
    rm -rf /tmp/sf19.tar.gz /tmp/sf19-extract

ENV NODE_ENV=production
ENV NODE_OPTIONS="--dns-result-order=ipv4first --max-old-space-size=1024"

COPY --from=builder /out ./

USER node

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/src/worker"]
