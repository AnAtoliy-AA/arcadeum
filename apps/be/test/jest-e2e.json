{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "forceExit": true,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(@nestjs/bullmq|@nestjs/bull-shared|bullmq|uuid))"
  ],
  "moduleNameMapper": {
    "^@arcadeum/games-core(.*)$": "<rootDir>/../../../packages/games-core/src$1"
  }
}
