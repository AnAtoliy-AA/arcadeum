{
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@arcadeum/games-core": ["../../packages/games-core/src"],
      "@arcadeum/games-core/*": ["../../packages/games-core/src/*"]
    },
    "jsx": "react-jsx",
    "customConditions": ["react-native", "react-native-legacy-deep-imports"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "extends": "expo/tsconfig.base"
}
