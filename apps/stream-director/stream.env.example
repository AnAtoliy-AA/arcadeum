# Copy to /etc/arcadeum-stream/stream.env (chmod 600). NO real values in git.

# --- Target (unset STREAM_RTMP_URL = DRY RUN) ---
# STREAM_RTMP_URL=rtmp://<platform-ingest>/<app>
# STREAM_KEY_FILE=/etc/arcadeum-stream/stream.key   # preferred
# STREAM_KEY=                                        # alternative

# --- Arcadeum ---
STREAM_BE_URL=https://api.example.com
STREAM_WEB_URL=https://arcadeum.games
STREAM_BOT_EMAIL=arcadeum-live@test.com
STREAM_BOT_PASSWORD=

# --- Video ---
STREAM_PROFILE=standard        # standard (720p30) | lite (720p25) | hd (1080p30)
# STREAM_VIDEO_KBPS=3500
# STREAM_X264_PRESET=veryfast
# STREAM_NICE=10

# --- Audio ---
STREAM_MUSIC_DIR=/var/lib/arcadeum-stream/music   # YOUR licensed tracks

# --- Ops ---
STREAM_KILL_FILE=/var/lib/arcadeum-stream/KILL
STREAM_STATUS_FILE=/var/lib/arcadeum-stream/status.json
STREAM_STATUS_PORT=9477
STREAM_ALERT_WEBHOOK_URL=
STREAM_RECYCLE_BROWSER_EVERY=10
