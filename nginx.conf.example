# nginx reverse proxy configuration for Arcadeum
# Addresses: #54 (HTTP/2), #55 (keep-alive), #56 (Brotli compression)
#
# Usage: include this file in your server{} block, or use as a reference
# for your existing proxy configuration.
#
# Horizontal scaling: The upstream block below supports multiple BE instances.
# ip_hash ensures WebSocket connections are sticky (same client → same backend).
# Add more servers to the upstream block as you scale out.

# --- #56: Brotli compression for static assets ---
# Requires: ngx_brotli module (install via package manager or compile)
# Falls back to gzip if Brotli is not available.
brotli on;
brotli_comp_level 6;
brotli_types
  application/javascript
  application/json
  application/xml
  text/css
  text/javascript
  text/plain
  text/xml
  image/svg+xml;

# Fallback gzip compression
gzip on;
gzip_comp_level 6;
gzip_types
  application/javascript
  application/json
  application/xml
  text/css
  text/javascript
  text/plain
  text/xml
  image/svg+xml;

server {
    # --- #54: Enable HTTP/2 (or HTTP/3 with QUIC if available) ---
    listen 443 ssl http2;
    # listen 443 quic;  # Uncomment for HTTP/3 support
    # add_header Alt-Svc 'h3=":443"; ma=86400';  # Announce HTTP/3

    server_name arcadeum.gg;

    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # --- #55: Keep-alive between proxy and Node.js ---
    # Horizontal scaling: ip_hash for sticky WebSocket sessions.
    # Each BE instance runs PM2 cluster on a single port.
    # Add more server entries as you deploy additional instances.
    upstream arcadeum_backend {
        ip_hash;
        server 127.0.0.1:4000;
        # server 152.70.47.29:4000;  # Instance 2 (if on different host)
        # server 129.159.10.232:4000; # Instance 3 (reserve/worker)
        keepalive 64;
        keepalive_timeout 60s;
    }

    upstream arcadeum_web {
        server 127.0.0.1:3000;
        keepalive 64;
        keepalive_timeout 60s;
    }

    location /api/ {
        proxy_pass http://arcadeum_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /socket.io/ {
        proxy_pass http://arcadeum_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Health check endpoint for load balancer / monitoring
    location /health {
        proxy_pass http://arcadeum_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://arcadeum_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
