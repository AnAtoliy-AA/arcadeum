{
  "name": "aicoapp-monorepo",
  "version": "1.25.38",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "echo postinstall",
    "prepare": "husky",
    "predev": "rm -rf .turbo node_modules/.cache",
    "dev": "turbo run dev --parallel --filter be --filter web --filter \"@arcadeum/ui\"",
    "dev:all": "turbo run dev --parallel && cd packages/ui && pnpm run dev",
    "dev:tg-bot": "pnpm --filter tg-bot dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format --parallel",
    "check-file-length": "node scripts/check-file-length.js",
    "check-translations": "node scripts/check_translation.js",
    "docs:check": "node scripts/check-doc-links.js",
    "generate-sprites": "node scripts/spritesheet/generate_spritesheet.js",
    "changelog": "auto-changelog --stdout --template ./scripts/changelog-template.hbs --unreleased --commit-limit false > CHANGELOG.md",
    "release": "standard-version"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "auto-changelog": "^2.6.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jimp": "^0.22.12",
    "lint-staged": "^15.5.2",
    "markdown-it": "^14.3.0",
    "prettier": "3.9.6",
    "standard-version": "^9.5.0",
    "turbo": "^2.10.9"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-test-renderer": "19.1.0",
      "react-server-dom-webpack": "19.0.1",
      "shell-quote": "1.8.4",
      "handlebars": ">=4.7.9",
      "tar": ">=7.5.19"
    }
  }
}
