{
  "name": "aicoapp-monorepo",
  "version": "1.27.22",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "echo postinstall",
    "prepare": "husky",
    "dev": "turbo run dev --parallel --filter be --filter web --filter \"@arcadeum/ui\"",
    "dev:all": "turbo run dev --parallel && cd packages/ui && pnpm run dev",
    "dev:tg-bot": "pnpm --filter tg-bot dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format --parallel",
    "check-file-length": "node scripts/check-file-length.js",
    "check-translations": "node scripts/check_translation.js",
    "docs:check": "node scripts/check-doc-links.js",
    "shorts:daily": "node scripts/shorts-factory/daily-runner.js",
    "shorts:daily:preview": "node scripts/shorts-factory/daily-runner.js --preview",
    "shorts:gameplay": "node scripts/shorts-factory/gameplay.js",
    "shorts:gameplay:preview": "node scripts/shorts-factory/gameplay.js --preview",
    "shorts:factory": "node scripts/shorts-factory/factory.js",
    "changelog": "auto-changelog --stdout --template ./scripts/changelog-template.hbs --unreleased --commit-limit false > CHANGELOG.md",
    "release": "standard-version"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "auto-changelog": "^2.6.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jimp": "^0.22.12",
    "lint-staged": "^15.5.2",
    "markdown-it": "^14.3.1",
    "prettier": "3.9.6",
    "standard-version": "^9.5.0",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.9.0",
      "handlebars": ">=4.7.9",
      "tar": ">=7.5.19",
      "node-forge": ">=1.4.0",
      "nanoid@<3.3.18": "3.3.18",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "ts-deepmerge@<8.0.0": ">=8.0.0",
      "joi@<17.13.4": ">=17.13.4 <18",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13 <0.9",
      "yaml@<2.8.3": ">=2.8.3 <3",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8 <6",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0 <9",
      "diff@>=6.0.0 <8.0.3": ">=8.0.3 <9"
    }
  }
}
