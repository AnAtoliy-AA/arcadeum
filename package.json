{
  "name": "aicoapp-monorepo",
  "version": "1.32.13",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "echo postinstall",
    "prepare": "husky",
    "dev": "turbo run dev --parallel --filter be --filter web",
    "dev:all": "turbo run dev --parallel --filter be --filter web --filter \"@arcadeum/ui\"",
    "start": "turbo run build --filter be --filter web && (pnpm --filter be start:prod & pnpm --filter web start)",
    "dev:tg-bot": "pnpm --filter tg-bot dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format --parallel",
    "clean": "rm -rf .turbo .wrangler .next node_modules/.cache apps/*/node_modules/.cache packages/*/node_modules/.cache apps/web/.next apps/be/dist apps/mobile/.expo packages/*/dist bots/*/dist apps/*/dist",
    "check-file-length": "node scripts/check-file-length.js",
    "check-translations": "node scripts/check_translation.js",
    "check-i18n-sync": "node scripts/sync-i18n.js",
    "check-content-gaps": "node scripts/check-content-gaps.js",
    "check-strategy-guides": "node scripts/check-strategy-guides.js",
    "check-sitemap": "node scripts/check-sitemap.js",
    "check-hreflang": "pnpm --filter web run seo:hreflang:audit",
    "docs:check": "node scripts/check-doc-links.js",
    "puzzles:generate": "node scripts/generate-chess-puzzles.mjs",
    "puzzles:seed": "node scripts/seed-chess-puzzles.mjs",
    "shorts:daily": "node scripts/shorts-factory/daily-runner.js",
    "shorts:daily:preview": "node scripts/shorts-factory/daily-runner.js --preview",
    "shorts:gameplay": "node scripts/shorts-factory/gameplay.js",
    "shorts:gameplay:preview": "node scripts/shorts-factory/gameplay.js --preview",
    "shorts:factory": "node scripts/shorts-factory/factory.js",
    "shorts:render:dry-run": "node scripts/shorts-factory/render/dry-run.js",
    "shorts:render:test": "node --test \"scripts/shorts-factory/render/__tests__/*.test.js\"",
    "shorts:dry-run": "node scripts/shorts-factory/scenarios/dry-run.js",
    "shorts:test": "node --test scripts/shorts-factory/scenarios/__tests__/*.test.js",
    "shorts:analytics:report": "node scripts/shorts-factory/analytics/report.js",
    "shorts:length:test": "node --test \"scripts/shorts-factory/length/__tests__/*.test.js\"",
    "shorts:analytics:test": "node --test scripts/shorts-factory/analytics/analytics.test.js",
    "stream:build": "pnpm --filter stream-director build",
    "stream:start": "pnpm --filter stream-director start:prod",
    "stream:dry-run": "pnpm --filter stream-director build && pnpm --filter stream-director dry-run",
    "stream:test": "pnpm --filter stream-director test",
    "vercel:clean": "python3 scripts/clean-vercel-deployments.sh",
    "vercel:clean:all": "python3 scripts/clean-vercel-deployments.sh --all",
    "vercel:clean:dry": "python3 scripts/clean-vercel-deployments.sh --dry-run",
    "changelog": "auto-changelog --stdout --template ./scripts/changelog-template.hbs --unreleased --commit-limit false > CHANGELOG.md",
    "release": "standard-version"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auto-changelog": "^2.7.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jimp": "^0.22.12",
    "lint-staged": "^15.5.2",
    "markdown-it": "^14.3.3",
    "prettier": "3.9.10",
    "standard-version": "^9.5.0",
    "turbo": "^2.11.8"
  }
}
