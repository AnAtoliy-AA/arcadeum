[Unit]
Description=Fetch Arcadeum secrets from OCI Vault into tmpfs
After=network-online.target
Wants=network-online.target
Before=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/arcadeum/vault.conf
ExecStartPre=mkdir -p /run/arcadeum-secrets
ExecStartPre=chown root:ubuntu /run/arcadeum-secrets
ExecStartPre=chmod 750 /run/arcadeum-secrets
ExecStart=/opt/arcadeum/scripts/fetch-secrets.sh /run/arcadeum-secrets/secrets.env
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
