{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ENABLE_EXPERIMENTAL_COREPACK",
    "ARCADEUM_MINT_ADDRESS",
    "SUPPORT_INTERNAL_TOKEN",
    "CSP_CONNECT_SRC"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "format": {
      "outputs": []
    }
  }
}
